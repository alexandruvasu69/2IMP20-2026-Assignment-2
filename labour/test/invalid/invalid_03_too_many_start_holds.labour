// Violates constraint 3: a route may have at most two start holds (three here).
bouldering_wall "ThreeStarts" {
  routes [
    bouldering_route "Starts" {
      grade: "5A",
      grid_base_point { x: 0, y: 0 },
      holds ["0001", "0002", "0003"]
    }
  ],
  volumes [
    circle {
      pos: { x: 0, y: 0 },
      depth: 10,
      radius: 20,
      front_holds [
        hold "0001" { pos: { x: 0, y: 0 }, shape: "1", colours [ red ], start_hold: 1 },
        hold "0002" { pos: { x: 1, y: 1 }, shape: "2", colours [ red ], start_hold: 2 },
        hold "0003" { pos: { x: 2, y: 2 }, shape: "3", colours [ red ], start_hold: 1 }
      ]
    }
  ]
}
