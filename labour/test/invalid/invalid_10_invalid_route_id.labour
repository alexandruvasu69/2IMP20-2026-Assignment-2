// Violates constraint 10: the route id must be alphanumeric ('#' is not allowed).
bouldering_wall "BadId" {
  routes [
    bouldering_route "bad#id" {
      grade: "5A",
      grid_base_point { x: 0, y: 0 },
      holds ["0001", "0002"]
    }
  ],
  volumes [
    circle {
      pos: { x: 0, y: 0 },
      depth: 10,
      radius: 20,
      front_holds [
        hold "0001" { pos: { x: 0, y: 0 }, shape: "1", colours [ red ] },
        hold "0002" { pos: { x: 1, y: 1 }, shape: "2", colours [ red ] }
      ]
    }
  ]
}
