// Invalid program: holds in circle side_holds must use angle-based positions, not x/y.
bouldering_wall "SideHoldXY" {
  routes [
    bouldering_route "Wrong side hold" {
      grade: "5A",
      grid_base_point { x: 0, y: 0 },
      holds ["0001", "0002"]
    }
  ],
  volumes [
    circle {
      pos: { x: 0, y: 0 },
      depth: 10,
      radius: 20,
      front_holds [
        hold "0001" {
          pos: { x: 0, y: 0 },
          shape: "1",
          colours [ red ]
        }
      ],
      side_holds [
        hold "0002" {
          pos: { x: 10, y: 5 },
          shape: "2",
          colours [ red ]
        }
      ]
    }
  ]
}
