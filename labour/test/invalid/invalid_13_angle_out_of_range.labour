// Violates constraint 13: an angle-defined position must be in [0, 359] (400 here).
bouldering_wall "BadAngle" {
  routes [
    bouldering_route "Angle" {
      grade: "5A",
      grid_base_point { x: 0, y: 0 },
      holds ["0001", "0002"]
    }
  ],
  volumes [
    circle {
      pos: { x: 0, y: 0 },
      depth: 10,
      radius: 20,
      front_holds [
        hold "0001" { pos: { x: 0, y: 0 }, shape: "1", colours [ red ] }
      ],
      side_holds [
        hold "0002" { pos: { angle: 400 }, shape: "2", colours [ red ] }
      ]
    }
  ]
}
