// Violates constraint 14: a rotation, if present, must be in [0, 359] (400 here).
bouldering_wall "BadRotation" {
  routes [
    bouldering_route "Rot" {
      grade: "5A",
      grid_base_point { x: 0, y: 0 },
      holds ["0001", "0002"]
    }
  ],
  volumes [
    circle {
      pos: { x: 0, y: 0 },
      depth: 10,
      radius: 20,
      front_holds [
        hold "0001" { pos: { x: 0, y: 0 }, shape: "1", colours [ red ], rotation: 400 },
        hold "0002" { pos: { x: 1, y: 1 }, shape: "2", colours [ red ] }
      ]
    }
  ]
}
