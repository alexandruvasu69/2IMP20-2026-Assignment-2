// Violates constraint 12: every hold must have a shape (hold 0001 has none).
bouldering_wall "NoShape" {
  routes [
    bouldering_route "Shapeless" {
      grade: "5A",
      grid_base_point { x: 0, y: 0 },
      holds ["0001", "0002"]
    }
  ],
  volumes [
    circle {
      pos: { x: 0, y: 0 },
      depth: 10,
      radius: 20,
      front_holds [
        hold "0001" { pos: { x: 0, y: 0 }, colours [ red ] },
        hold "0002" { pos: { x: 1, y: 1 }, shape: "2", colours [ red ] }
      ]
    }
  ]
}
